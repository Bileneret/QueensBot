# ==============================================================================
# QueensBot Configuration
# ==============================================================================

# Target Android device serial number or IP:port (optional)
# Leave empty to automatically detect the first connected device via `adb devices`
ADB_DEVICE_SERIAL=

# Scrcpy H.264 stream bitrate in bits/sec (default: 6000000 -> 6 Mbps)
SCRCPY_BITRATE=6000000

# Scrcpy capture framerate (default: 30, recommended: 30 or 60)
SCRCPY_FPS=30
